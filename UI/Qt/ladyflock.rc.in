#include <winver.h>

IDI_ICON1 ICON "@windows_icon@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @windows_version_numeric@
PRODUCTVERSION @windows_version_numeric@
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Ladyflock"
            VALUE "FileDescription", "Ladyflock (Ladybird)"
            VALUE "FileVersion", "@LADYFLOCK_BROWSER_VERSION@"
            VALUE "InternalName", "Ladyflock"
            VALUE "LegalCopyright", "Copyright (c) the Ladyflock and Ladybird developers"
            VALUE "OriginalFilename", "Ladyflock.exe"
            VALUE "ProductName", "Ladyflock"
            VALUE "ProductVersion", "@LADYFLOCK_BROWSER_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
