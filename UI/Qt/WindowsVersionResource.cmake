if (NOT LADYFLOCK_BROWSER_VERSION MATCHES "^[0-9]+(\\.[0-9]+)*$")
    message(FATAL_ERROR "The Windows version resource requires a dot-separated numeric LADYFLOCK_VERSION.")
endif()
string(REPLACE "." ";" windows_version_components "${LADYFLOCK_BROWSER_VERSION}")
list(LENGTH windows_version_components windows_version_component_count)
if (windows_version_component_count GREATER 4)
    message(FATAL_ERROR "The Windows version resource requires at most four LADYFLOCK_VERSION components.")
endif()

set(windows_version_numbers)
foreach (component IN LISTS windows_version_components)
    # Strip leading zeroes so the resource compiler interprets every component as decimal.
    string(REGEX REPLACE "^0+" "" component "${component}")
    if (component GREATER 65535)
        message(FATAL_ERROR "The Windows version resource requires LADYFLOCK_VERSION components between 0 and 65535.")
    endif()
    if (component STREQUAL "")
        set(component 0)
    endif()
    list(APPEND windows_version_numbers "${component}")
endforeach()
while (windows_version_component_count LESS 4)
    list(APPEND windows_version_numbers 0)
    math(EXPR windows_version_component_count "${windows_version_component_count} + 1")
endwhile()
list(JOIN windows_version_numbers "," windows_version_numeric)

set(windows_icon "${CMAKE_CURRENT_LIST_DIR}/../Icons/windows/ladyflock.ico")
set(windows_resource "${CMAKE_CURRENT_BINARY_DIR}/ladyflock.rc")
configure_file("${CMAKE_CURRENT_LIST_DIR}/ladyflock.rc.in" "${windows_resource}" @ONLY)
set_source_files_properties("${windows_resource}" PROPERTIES OBJECT_DEPENDS "${windows_icon}")
target_sources(ladybird PRIVATE "${windows_resource}")
