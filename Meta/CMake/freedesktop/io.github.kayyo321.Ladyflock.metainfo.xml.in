<?xml version="1.0" encoding="UTF-8"?>
<!-- Copyright 2025-present, the Ladybird developers. -->
<!-- Copyright 2026-present, the Ladyflock developers. -->
<component type="desktop-application">
  <id>io.github.kayyo321.Ladyflock</id>

  <name>Ladyflock</name>
  <summary>Independent web browser built on the Ladybird engine</summary>

  <developer id="io.github.kayyo321">
    <name>Ladyflock developers</name>
  </developer>

  <url type="homepage">https://github.com/Kayyo321/Ladyflock</url>
  <url type="bugtracker">https://github.com/Kayyo321/Ladyflock/issues</url>
  <url type="vcs-browser">https://github.com/Kayyo321/Ladyflock</url>

  <metadata_license>0BSD</metadata_license>
  <project_license>BSD-2-Clause</project_license>
  <content_rating type="oars-1.1" />

  <description>
    <p>
      Ladyflock (Ladybird) is an independent web browser built on the Ladybird engine.
      Driven by a web standards first approach, Ladyflock aims to render the modern web with good performance, stability, security, and Firefox WebExtensions support.
    </p>
  </description>

  <provides>
    <mediatype>text/html</mediatype>
    <mediatype>text/xml</mediatype>
    <mediatype>application/xhtml+xml</mediatype>
    <mediatype>x-scheme-handler/http</mediatype>
    <mediatype>x-scheme-handler/https</mediatype>
  </provides>

  <launchable type="desktop-id">io.github.kayyo321.Ladyflock.desktop</launchable>
  <releases>
    <release version="@METAINFO_RELEASE_VERSION@" type="@METAINFO_RELEASE_TYPE@" date="@DATE@">
      <description>
        <p>
          @METAINFO_RELEASE_DESCRIPTION@
        </p>
      </description>
    </release>
  </releases>

  <branding>
    <color type="primary" scheme_preference="light">#9d7cf2</color>
    <color type="primary" scheme_preference="dark">#8a64e5</color>
  </branding>

</component>
